{
  "openapi": "3.1.0",
  "info": {
    "title": "Pecarn Pediatric Head Injury API",
    "description": "Age-specific PECARN decision rule and separately labeled legacy demonstration endpoints. The FastAPI /openapi.json response is authoritative.",
    "version": "4.0.0",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "System optimal"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Legacy demonstration counters (JSON, not Prometheus)",
        "responses": {
          "200": {
            "description": "Prometheus text metrics"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Legacy generic demonstration, not PECARN",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Legacy deterministic mock, not clinical reasoning",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve and cryptographically verify HMAC audit trail",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Serve standalone PECARN browser calculator",
        "responses": {
          "200": {
            "description": "Static browser application"
          }
        }
      }
    },
    "/app.js": {
      "get": {
        "summary": "Serve offline PECARN browser rule JavaScript",
        "responses": {
          "200": {
            "description": "JavaScript program"
          }
        }
      }
    },
    "/api/pecarn": {
      "post": {
        "summary": "Classify eligible minor blunt head trauma using age-specific PECARN criteria",
        "description": "Clinical findings required explicitly; rejects missing, inapplicable, or out-of-scope cases.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PECARNRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Decision-rule category and CT guidance"
          },
          "422": {
            "description": "Invalid, incomplete, or ineligible assessment"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PECARNRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "age_months",
          "gcs",
          "hours_since_injury",
          "exclusion_present",
          "altered_mental_status",
          "severe_mechanism"
        ],
        "properties": {
          "age_months": {
            "type": "integer",
            "minimum": 0,
            "maximum": 215
          },
          "gcs": {
            "type": "integer",
            "enum": [
              14,
              15
            ]
          },
          "hours_since_injury": {
            "type": "number",
            "minimum": 0,
            "maximum": 24
          },
          "exclusion_present": {
            "type": "boolean"
          },
          "altered_mental_status": {
            "type": "boolean"
          },
          "severe_mechanism": {
            "type": "boolean"
          },
          "palpable_skull_fracture": {
            "type": "boolean",
            "description": "Required only for applicable age cohort; must be omitted for other cohort"
          },
          "nonfrontal_scalp_hematoma": {
            "type": "boolean",
            "description": "Required only for applicable age cohort; must be omitted for other cohort"
          },
          "loc_at_least_5_seconds": {
            "type": "boolean",
            "description": "Required only for applicable age cohort; must be omitted for other cohort"
          },
          "not_acting_normally": {
            "type": "boolean",
            "description": "Required only for applicable age cohort; must be omitted for other cohort"
          },
          "basilar_skull_fracture_signs": {
            "type": "boolean",
            "description": "Required only for applicable age cohort; must be omitted for other cohort"
          },
          "any_loss_of_consciousness": {
            "type": "boolean",
            "description": "Required only for applicable age cohort; must be omitted for other cohort"
          },
          "vomiting": {
            "type": "boolean",
            "description": "Required only for applicable age cohort; must be omitted for other cohort"
          },
          "severe_headache": {
            "type": "boolean",
            "description": "Required only for applicable age cohort; must be omitted for other cohort"
          }
        }
      }
    }
  }
}
